{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chendownloader",
  "version": "1.1.1",
  "identifier": "app.localmediadownloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "width": 990,
        "height": 540,
        "minWidth": 780,
        "minHeight": 540,
        "title": "chendownloader"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.instagram.com; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/chen.ico"
    ]
  }
}
